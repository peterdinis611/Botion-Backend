# Keep the same value across backend restarts or all JWTs become invalid immediately.
JWT_SECRET=change-me-in-production-use-long-random-string

# Session length in seconds (default 2592000 = 30 days)
JWT_EXPIRES_IN_SECONDS=2592000

# HTTP port (default 3000)
# PORT=3000

# CORS origin for the Next.js app (default http://localhost:3001)
# FRONTEND_URL=http://localhost:3001

# Set to false to disable createDemoAccount
# DEMO_ACCOUNTS_ENABLED=false

# Public site URL (used by frontend SEO metadata)
# NEXT_PUBLIC_SITE_URL=http://localhost:3001
